{
  "name": "@petersutarik/gmail-mcp-server",
  "version": "1.2.0",
  "description": "Gmail MCP server with auto authentication and draft management",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gmail-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --noCheck",
    "start": "node dist/index.js",
    "auth": "node dist/index.js auth",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "gmail",
    "mcp",
    "model-context-protocol",
    "google-gmail",
    "claude",
    "drafts"
  ],
  "author": "Peter Sutarik",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petersutarik/gmail-mcp-server.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "@types/mime-types": "^2.1.4",
    "google-auth-library": "^9.4.1",
    "googleapis": "^129.0.0",
    "mime-types": "^3.0.1",
    "nodemailer": "^7.0.3",
    "open": "^10.0.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.3.3"
  }
}
